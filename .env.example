# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_b2_region

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005EXAMPLE_NOT_A_REAL_APP_KEY
# B2_BUCKET_NAME=my-sensor-data-lake
# B2_REGION=us-west-004
# The S3 endpoint is derived from B2_REGION (https://s3.<region>.backblazeb2.com).

# Optional: public base URL for objects if the bucket is public (no trailing slash).
# B2_PUBLIC_URL_BASE=https://my-sensor-data-lake.s3.us-west-004.backblazeb2.com

# CARLA simulator (optional — only needed to actually RUN a scenario).
# The lake's manage/browse/serve side works without these; a run reaches a
# user-hosted CARLA server on a supported Linux/GPU host. See docs/features/simulation-runner.md.
# CARLA_HOST=localhost
# CARLA_PORT=2000
# CARLA_TIMEOUT=20

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
